# Servidor
NODE_ENV=production
PORT=3001

# Alexa (obrigatório, o applicationId da sua skill no Alexa Developer Console)
ALEXA_SKILL_ID=

# Claude Code CLI
CLAUDE_MODEL=haiku
CLAUDE_EFFORT=low
CLAUDE_MAX_TURNS=3
CLAUDE_RESTRICTED=true
CLAUDE_RESPONSE_DEADLINE_MS=7500

# Fallback do Telegram para respostas que passaram do CLAUDE_RESPONSE_DEADLINE_MS (opcional, deixe os dois em branco para desativar)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Nível de log (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
